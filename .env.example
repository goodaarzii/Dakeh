# Local development settings only. Never use these sample values in production.

# HTTP API
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (must match docker-compose.yaml)
POSTGRES_USER=dakeh
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_DB=dakeh
DATABASE_URL=postgres://dakeh:local-postgres-password-change-me@localhost:5432/dakeh?sslmode=disable

# Goose migrations (used by Taskfile)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=host=localhost user=dakeh password=local-postgres-password-change-me dbname=dakeh sslmode=disable
GOOSE_MIGRATION_DIR=./db/migrations

# Authentication and refresh sessions
JWTSecret=local-development-secret-change-this-before-deployment-2026
JWTExpirationInSeconds=900
RefreshExpirationInSeconds=2592000

# Redis cart (must match docker-compose.yaml)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=local-redis-password-change-me
REDIS_DB=0
CartExpirationInSeconds=2592000

# MinIO / S3-compatible product image storage (must match docker-compose.yaml)
MINIO_ROOT_USER=dakeh
MINIO_ROOT_PASSWORD=local-minio-password-change-me
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=dakeh
S3_SECRET_KEY=local-minio-password-change-me
S3_BUCKET=dakeh-images
S3_PUBLIC_BASE_URL=http://localhost:9000/dakeh-images
S3_USE_SSL=false
